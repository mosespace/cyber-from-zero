{
  "name": "cyber-from-zero",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly cybersecurity course in simple English, with a Next.js learning site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "audio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-audio.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
